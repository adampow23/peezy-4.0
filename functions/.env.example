# Peezy Brain Environment Variables

# REQUIRED: Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Model override (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: Max tokens for response (defaults to 1024)
MAX_TOKENS=1024

# Optional: Request timeout in ms (defaults to 25000)
REQUEST_TIMEOUT=25000

# Optional: Enable debug logging (defaults to false)
DEBUG_MODE=false

# Optional: Email address that receives new support-message notifications.
# Leave blank to disable support email notifications.
SUPPORT_NOTIFY_EMAIL=

# Optional: E.164 phone number that receives new support-message notifications.
# Leave blank to disable support SMS notifications.
SUPPORT_NOTIFY_SMS=

# Required for support admin callables: comma-separated authorized account emails.
SUPPORT_ADMIN_EMAILS=adam@peezymove.com
