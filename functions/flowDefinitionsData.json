        "bodyVariants": [
          {
            "when": {
              "handling_cancel": "peezy",
              "handling_find": "peezy"
            },
            "body": "Your vet plan is ready — use the records-request script with your current clinic, then compare the sourced options near your new place."
          },
          {
            "when": {
              "handling_cancel": "peezy"
            },
            "body": "Your records-transfer checklist is ready — here's what to request from your current vet before you choose a new one."
          }
        ]
      },
      {
        "id": "find_tip",
        "kind": "info",
