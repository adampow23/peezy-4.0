  {
   "workflowId": "setup_utilities",
   "taskTitle": "Set up my new utilities",
   "steps": [
    {
     "id": "title",
     "kind": "title",
     "icon": "bolt.fill",
     "next": "included"
    },
    {
     "id": "included",
     "kind": "select",
     "question": "Does the new place include any utilities in the rent?",
     "options": [
      {
       "id": "yes",
       "label": "Yes, some are included",
       "icon": "checkmark.circle"
      },
      {
       "id": "no",
       "label": "No, all on me",
       "icon": "bolt.fill"
      }
     ],
     "next": "handling",
     "branches": [
      {
       "value": "yes",
       "next": "included_info"
      },
      {
       "value": "no",
       "next": "handling"
      }
     ]
    },
    {
     "id": "handling",
     "kind": "decision",
     "timeSaved": "~2.5 hrs",
     "stage": "capture",
     "next": "confirmed_address",
     "branches": [
      {
       "value": "peezy",
       "next": "confirmed_address"
      },
      {
       "value": "self",
       "next": "tip"
      }
     ]
    },
    {
     "id": "confirmed_address",
     "kind": "confirmAddress",
     "question": "Is this your new address?",
     "addressSource": "new",
     "displayIcon": "mappin.and.ellipse",
     "next": "summary"
    },
    {
     "id": "summary",
     "kind": "summary",
     "body": "Your utility setup list is ready: each provider, the number to call, and what to ask so service starts before you arrive.",
     "subtext": "Use the confirmed address when you open each provider's official setup path."
    },
    {
     "id": "tip",
     "kind": "info",
     "body": "Get a 'letter of credit' from your old utility — waives the deposit.",
     "next": "status"
    },
    {
     "id": "status",
     "kind": "status"
    },
    {
     "id": "included_info",
     "kind": "info",
     "body": "Confirm with the landlord exactly which ones — then set up only the rest. Start date on those: the day BEFORE move-in.",
     "next": "status"
    }
