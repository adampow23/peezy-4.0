rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // S3 (briefs/S3_BRIEF.md; PHASE2_CONTRACT.md C3, C6.1): once the owner root carries an
    // accountDeletion marker in any state (a malformed marker included) the owner is denied
    // every read and write across user paths; descendant and userKnowledge writes exist only
    // under marker absence. A missing root document is marker absence.
    function deletionAbsent(userId) {
      let root = get(/databases/$(database)/documents/users/$(userId));
      return root == null || !('accountDeletion' in root.data);
    }

    function isLiveOwner(userId) {
      return isOwner(userId) && deletionAbsent(userId);
    }

    function taskResetInactive(userId) {
      let user = get(/databases/$(database)/documents/users/$(userId));
      return !('taskReset' in user.data)
        || !(user.data.taskReset.state in ['deleting', 'awaiting_local_reset']);
    }

    // S1 first pass (briefs/S1_BRIEF.md; manifest §5:540-546): epoch stamps.
    // Effective root epoch is absent → 0, present safe integer → that value.
    // taskGenerationEpoch on the root is server-owned. Cleanup/deletion
    // predicates under the awaiting_local_reset marker belong to S3.
    function rootData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isSafeEpoch(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    function effectiveEpoch(data) {
      return ('taskGenerationEpoch' in data) ? data.taskGenerationEpoch : 0;
    }

    function rootEpoch(userId) {
      return effectiveEpoch(rootData(userId));
    }

    function taskResetAbsent(userId) {
      return !('taskReset' in rootData(userId));
    }

    function stampedCreate(userId, data) {
      return taskResetAbsent(userId)
        && 'task_generation_epoch' in data
        && isSafeEpoch(data.task_generation_epoch)
        && data.task_generation_epoch == rootEpoch(userId);
    }

    // Stamped rows keep their stamp, which must equal the root epoch; an
    // unstamped row may be updated only while the root epoch is exactly 0 and
    // must stay unstamped (shipped epoch-zero compatibility).
    function stampedUpdate(userId, before, after) {
      return taskResetAbsent(userId)
        && (('task_generation_epoch' in before)
          ? ('task_generation_epoch' in after
              && after.task_generation_epoch == before.task_generation_epoch
              && before.task_generation_epoch == rootEpoch(userId))
          : (!('task_generation_epoch' in after) && rootEpoch(userId) == 0));
    }

    // userKnowledge additionally permits the one-time epoch-zero upgrade of an
    // unstamped document; at any later epoch an unstamped document rejects.
    function knowledgeUpdate(userId, before, after) {
      return taskResetAbsent(userId)
        && 'task_generation_epoch' in after
        && isSafeEpoch(after.task_generation_epoch)
        && after.task_generation_epoch == rootEpoch(userId)
        && (('task_generation_epoch' in before)
          ? after.task_generation_epoch == before.task_generation_epoch
          : rootEpoch(userId) == 0);
    }

    function stampedDailyDose(dose, epoch) {
      return dose is map
        && dose.keys().hasOnly(['schema_version', 'task_generation_epoch', 'date', 'taskIds'])
        && dose.keys().hasAll(['schema_version', 'task_generation_epoch', 'date', 'taskIds'])
        && dose.schema_version == 1
        && isSafeEpoch(dose.task_generation_epoch)
        && dose.task_generation_epoch == epoch
        && dose.date is string
        && dose.taskIds is list;
    }

    function isReservedTaskId(taskId) {
      return taskId.matches('^(t1_|t2_|a2_).*');
    }

    function hasDispositionContract(data) {
      return data.keys().hasAny(['dispositionContract']);
    }

    function hasPlanAudit(data) {
      return data.keys().hasAny([
        'planChangeRevision',
        'planChangeState',
        'planChangeHistory',
        'pendingAmendmentTaskId',
        'firstConfirmationUndoUntil',
        'confirmationUndoUsed',
        'confirmationOriginalFingerprint',
        'confirmationAmendmentFingerprint'
      ]);
    }

    function hasServerTaskCreateFields(data) {
      return data.keys().hasAny([
        'dispositionContract',
        'spawnedFrom',
        'subject',
        'institutionId',
        'institution',
        'canonicalKeyVersion',
        'supersedes',
        'supersededBy',
        'planChangeRevision',
        'planChangeState',
        'planChangeHistory',
        'pendingAmendmentTaskId',
        'firstConfirmationUndoUntil',
        'confirmationUndoUsed',
        'confirmationOriginalFingerprint',
        'confirmationAmendmentFingerprint'
      ]);
    }

    function changesServerTaskFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'dispositionContract',
        'spawnedFrom',
        'subject',
        'institutionId',
        'institution',
        'canonicalKeyVersion',
        'supersedes',
        'supersededBy',
        'planChangeRevision',
        'planChangeState',
        'planChangeHistory',
        'pendingAmendmentTaskId',
        'firstConfirmationUndoUntil',
        'confirmationUndoUsed',
        'confirmationOriginalFingerprint',
        'confirmationAmendmentFingerprint',
        'flowRows',
        'id',
        'userId',
        'taskId'
      ]);
    }

    // User document — owner-readable. The subscription entitlement field is
    // backend-owned (validateSubscription / gift redemption, Admin SDK):
    // owner writes may never create, modify, or remove it. Root-doc delete
    // is server-side only (deleteAccount, Admin SDK).
    match /users/{userId} {
      // An absent root reads as marker absence (the D15 point-path read precedes creation).
      allow read: if isOwner(userId) && (resource == null || !('accountDeletion' in resource.data));
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['subscription', 'taskReset', 'taskGenerationEpoch', 'accountDeletion'])
        && (!('dailyDose' in request.resource.data)
          || stampedDailyDose(request.resource.data.dailyDose, 0));
      allow update: if isOwner(userId)
        && !('accountDeletion' in resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscription', 'taskReset', 'taskGenerationEpoch', 'accountDeletion'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyDose'])
          || !('dailyDose' in request.resource.data)
          || stampedDailyDose(request.resource.data.dailyDose, effectiveEpoch(resource.data)));
      allow delete: if false;
    }

    // Support messages are owner-readable, but support replies and metadata are
    // backend-owned. Owners may create user messages and mark support replies read.
    match /users/{userId}/supportChat/{messageId} {
      allow read: if isLiveOwner(userId);
      allow create: if isLiveOwner(userId)
        && messageId != '_meta'
        && request.resource.data.sender == 'user';
      allow update: if isLiveOwner(userId)
        && messageId != '_meta'
        && resource.data.sender == 'support'
        && request.resource.data.read is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Read receipts are written only by Admin SDK support callables.
    match /users/{userId}/supportChat/_meta {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }

    // Task lifecycle is client-writable only for contractless, audit-free rows.
    // Server-authored identity/provenance and generated flow rows are immutable.
    match /users/{userId}/tasks/{taskId} {
      allow read: if isLiveOwner(userId);
      allow create: if isLiveOwner(userId)
        && taskResetInactive(userId)
        && !isReservedTaskId(taskId)
        && !hasServerTaskCreateFields(request.resource.data);
      allow update: if isLiveOwner(userId)
        && taskResetInactive(userId)
        && !taskId.matches('^a2_.*')
        && !hasDispositionContract(resource.data)
        && !hasDispositionContract(request.resource.data)
        && !hasPlanAudit(resource.data)
        && !hasPlanAudit(request.resource.data)
        && !changesServerTaskFields();
      allow delete: if isLiveOwner(userId)
        && taskResetInactive(userId)
        && !taskId.matches('^a2_.*')
        && !hasDispositionContract(resource.data)
        && !hasPlanAudit(resource.data);
    }

    // Inventoried client-owned user collections.
    // FCM tokens (C6.8): the client writes exactly {createdAt: <server Timestamp>, platform: "ios"};
    // the token collection is never client-readable or listable; the owner may delete its token.
    match /users/{userId}/fcmTokens/{token} {
      allow read: if false;
      allow create, update: if isLiveOwner(userId)
        && request.resource.data.keys().hasOnly(['createdAt', 'platform'])
        && request.resource.data.keys().hasAll(['createdAt', 'platform'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.platform == 'ios';
      allow delete: if isLiveOwner(userId);
    }
    match /users/{userId}/packingPlan/{document=**} {
      allow read, write: if isLiveOwner(userId);
    }
    match /users/{userId}/readiness/{document=**} {
      allow read, write: if isLiveOwner(userId);
    }
    match /users/{userId}/user_assessments/{assessmentId} {
      allow read: if isLiveOwner(userId);
      allow create: if isLiveOwner(userId)
        && stampedCreate(userId, request.resource.data);
      allow update: if isLiveOwner(userId)
        && stampedUpdate(userId, resource.data, request.resource.data);
      allow delete: if isLiveOwner(userId);
    }

    // Server-owned lifecycle and scheduler inputs are owner-readable only.
    match /users/{userId}/spawnTokens/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/events/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/eventState/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/taskPlanOperations/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }

    // Existing server-owned output surfaces retain owner read access.
    match /users/{userId}/packingAggregate/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/research/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/workflowResponses/{document=**} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/chats/{chatId}/messages/{messageId} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }

    match /phase1System/{document=**} {
      allow read, write: if false;
    }

    // Server-only Phase 2 state (C3): reconciler state, work rows, outbound leases, migration
    // records, event archive chunks, and scheduler refusals are never client-accessible.
    match /phase2System/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionStorageWork/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionAuthWork/{document=**} {
      allow read, write: if false;
    }
    match /users/{userId}/outboundLeases/{document=**} {
      allow read, write: if false;
    }
    match /users/{userId}/legacyResetMigrations/{document=**} {
      allow read, write: if false;
    }
    match /{path=**}/eventArchiveChunks/{document} {
      allow read, write: if false;
    }
    match /{path=**}/schedulerRefusals/{document} {
      allow read, write: if false;
    }

    // Inventory sessions (temporary processing data)
    match /users/{userId}/inventorySessions/{document=**} {
      allow read, write: if isLiveOwner(userId);
    }

    // Permanent inventory storage
    match /users/{userId}/inventory/{document=**} {
      allow read, write: if isLiveOwner(userId);
    }

    // Identity doc (users/{uid}/identity/identity) — written at assessment
    // completion, migrated on launch, edited from Settings. NOT DEPLOYED:
    // reconcile with the live waitlist rule before deploying (Adam's batch).
    match /users/{userId}/identity/{document=**} {
      allow read, write: if isLiveOwner(userId);
    }

    // Per-user knowledge doc (assessment data keyed by uid) — written by
    // AssessmentDataManager.saveAssessment and edited from Settings
    match /userKnowledge/{userId} {
      allow read: if isLiveOwner(userId);
      allow create: if isLiveOwner(userId)
        && stampedCreate(userId, request.resource.data);
      allow update: if isLiveOwner(userId)
        && knowledgeUpdate(userId, resource.data, request.resource.data);
      allow delete: if isLiveOwner(userId);
    }

    // Remembered conversation answers (users/{uid}/moveAnswers/answers) —
    // written only by the spawnTasks Cloud Function (Admin SDK). Owner read.
    match /users/{userId}/moveAnswers/{doc} {
      allow read: if isLiveOwner(userId);
      allow write: if false;
    }

    // Task catalog — readable by any authenticated user
    match /taskCatalog/{document=**} {
      allow read: if request.auth != null;
    }

    // Marketing-site waitlist — public unauthenticated create only.
    // Created by peezy-site (Next.js) via Firestore client SDK.
    match /waitlist/{doc} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['email', 'source', 'timestamp', 'userAgent']
        )
        && request.resource.data.keys().hasAll(
          ['email', 'source', 'timestamp', 'userAgent']
        )
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.source in ['hero', 'footer']
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 1024
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // Marketing-site waitlist signups — writes only from the joinWaitlist
    // Cloud Function (via Admin SDK, which bypasses these rules).
    // No client read or write access.
    match /waitlistSignups/{document=**} {
      allow read, write: if false;
    }

    // Config-driven workflows are readable by signed-in clients only.
    // Definitions remain backend-owned: no client writes.
    match /flowDefinitions/{document=**} {
      allow read: if request.auth != null;
    }

    match /appConfig/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Vendor rate cards are backend-owned; signed-in clients may only read.
    match /vendors/{document=**} {
      allow read: if request.auth != null;
    }

    // Provider action directory is backend-owned; clients may only read.
    match /providerDirectory/{document=**} {
      allow read: if request.auth != null;
    }

    // Curated ISP plans are backend-owned; clients may only read.
    // Included in Spec 07's single rules deploy gate with providerDirectory.
    match /ispPlans/{document=**} {
      allow read: if request.auth != null;
    }
  }
}
