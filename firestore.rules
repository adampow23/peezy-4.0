rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function taskResetInactive(userId) {
      let user = get(/databases/$(database)/documents/users/$(userId));
      return !('taskReset' in user.data)
        || !(user.data.taskReset.state in ['deleting', 'awaiting_local_reset']);
    }

    function isReservedTaskId(taskId) {
      return taskId.matches('^(t1_|t2_|a2_).*');
    }

    function hasDispositionContract(data) {
      return data.keys().hasAny(['dispositionContract']);
    }

    function hasPlanAudit(data) {
      return data.keys().hasAny([
        'planChangeRevision',
        'planChangeState',
        'planChangeHistory',
        'pendingAmendmentTaskId',
        'firstConfirmationUndoUntil',
        'confirmationUndoUsed',
        'confirmationOriginalFingerprint',
        'confirmationAmendmentFingerprint'
      ]);
    }

    function hasServerTaskCreateFields(data) {
      return data.keys().hasAny([
        'dispositionContract',
        'spawnedFrom',
        'subject',
        'institutionId',
        'institution',
        'canonicalKeyVersion',
        'supersedes',
        'supersededBy',
        'planChangeRevision',
        'planChangeState',
        'planChangeHistory',
        'pendingAmendmentTaskId',
        'firstConfirmationUndoUntil',
        'confirmationUndoUsed',
        'confirmationOriginalFingerprint',
        'confirmationAmendmentFingerprint'
      ]);
    }

    function changesServerTaskFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'dispositionContract',
        'spawnedFrom',
        'subject',
        'institutionId',
        'institution',
        'canonicalKeyVersion',
        'supersedes',
        'supersededBy',
        'planChangeRevision',
        'planChangeState',
        'planChangeHistory',
        'pendingAmendmentTaskId',
        'firstConfirmationUndoUntil',
        'confirmationUndoUsed',
        'confirmationOriginalFingerprint',
        'confirmationAmendmentFingerprint',
        'flowRows',
        'id',
        'userId',
        'taskId'
      ]);
    }

    // User document — owner-readable. The subscription entitlement field is
    // backend-owned (validateSubscription / gift redemption, Admin SDK):
    // owner writes may never create, modify, or remove it. Root-doc delete
    // is server-side only (deleteAccount, Admin SDK).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['subscription', 'taskReset']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscription', 'taskReset']);
      allow delete: if false;
    }

    // Support messages are owner-readable, but support replies and metadata are
    // backend-owned. Owners may create user messages and mark support replies read.
    match /users/{userId}/supportChat/{messageId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && messageId != '_meta'
        && request.resource.data.sender == 'user';
      allow update: if isOwner(userId)
        && messageId != '_meta'
        && resource.data.sender == 'support'
        && request.resource.data.read is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Read receipts are written only by Admin SDK support callables.
    match /users/{userId}/supportChat/_meta {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Task lifecycle is client-writable only for contractless, audit-free rows.
    // Server-authored identity/provenance and generated flow rows are immutable.
    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && taskResetInactive(userId)
        && !isReservedTaskId(taskId)
        && !hasServerTaskCreateFields(request.resource.data);
      allow update: if isOwner(userId)
        && taskResetInactive(userId)
        && !taskId.matches('^a2_.*')
        && !hasDispositionContract(resource.data)
        && !hasDispositionContract(request.resource.data)
        && !hasPlanAudit(resource.data)
        && !hasPlanAudit(request.resource.data)
        && !changesServerTaskFields();
      allow delete: if isOwner(userId)
        && taskResetInactive(userId)
        && !taskId.matches('^a2_.*')
        && !hasDispositionContract(resource.data)
        && !hasPlanAudit(resource.data);
    }

    // Inventoried client-owned user collections.
    match /users/{userId}/fcmTokens/{document=**} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/packingPlan/{document=**} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/readiness/{document=**} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/user_assessments/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Server-owned lifecycle and scheduler inputs are owner-readable only.
    match /users/{userId}/spawnTokens/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/events/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/eventState/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/taskPlanOperations/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Existing server-owned output surfaces retain owner read access.
    match /users/{userId}/packingAggregate/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/research/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/workflowResponses/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/chats/{chatId}/messages/{messageId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /phase1System/{document=**} {
      allow read, write: if false;
    }

    // Inventory sessions (temporary processing data)
    match /users/{userId}/inventorySessions/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Permanent inventory storage
    match /users/{userId}/inventory/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Identity doc (users/{uid}/identity/identity) — written at assessment
    // completion, migrated on launch, edited from Settings. NOT DEPLOYED:
    // reconcile with the live waitlist rule before deploying (Adam's batch).
    match /users/{userId}/identity/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Per-user knowledge doc (assessment data keyed by uid) — written by
    // AssessmentDataManager.saveAssessment and edited from Settings
    match /userKnowledge/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Remembered conversation answers (users/{uid}/moveAnswers/answers) —
    // written only by the spawnTasks Cloud Function (Admin SDK). Owner read.
    match /users/{userId}/moveAnswers/{doc} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Task catalog — readable by any authenticated user
    match /taskCatalog/{document=**} {
      allow read: if request.auth != null;
    }

    // Marketing-site waitlist — public unauthenticated create only.
    // Created by peezy-site (Next.js) via Firestore client SDK.
    match /waitlist/{doc} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['email', 'source', 'timestamp', 'userAgent']
        )
        && request.resource.data.keys().hasAll(
          ['email', 'source', 'timestamp', 'userAgent']
        )
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.source in ['hero', 'footer']
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 1024
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // Marketing-site waitlist signups — writes only from the joinWaitlist
    // Cloud Function (via Admin SDK, which bypasses these rules).
    // No client read or write access.
    match /waitlistSignups/{document=**} {
      allow read, write: if false;
    }

    // Config-driven workflows are readable by signed-in clients only.
    // Definitions remain backend-owned: no client writes.
    match /flowDefinitions/{document=**} {
      allow read: if request.auth != null;
    }

    match /appConfig/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Vendor rate cards are backend-owned; signed-in clients may only read.
    match /vendors/{document=**} {
      allow read: if request.auth != null;
    }

    // Provider action directory is backend-owned; clients may only read.
    match /providerDirectory/{document=**} {
      allow read: if request.auth != null;
    }

    // Curated ISP plans are backend-owned; clients may only read.
    // Included in Spec 07's single rules deploy gate with providerDirectory.
    match /ispPlans/{document=**} {
      allow read: if request.auth != null;
    }
  }
}
